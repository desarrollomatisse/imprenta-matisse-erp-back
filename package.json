{
  "name": "imprenta-matisse-erp-back",
  "version": "4.0.0",
  "private": true,
  "description": "API NestJS del ERP de Imprenta Matisse",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "typeorm": "typeorm -d dist/database/data-source.js",
    "migration:run": "nest build && typeorm -d dist/database/data-source.js migration:run",
    "migration:revert": "nest build && typeorm -d dist/database/data-source.js migration:revert",
    "migration:show": "nest build && typeorm -d dist/database/data-source.js migration:show",
    "migration:check": "nest build && typeorm -d dist/database/data-source.js schema:log",
    "seed": "nest build && node dist/database/seed.js",
    "seed:demo": "nest build && node dist/database/seed.js && node dist/database/seed-demo.js",
    "admin:create": "nest build && node dist/database/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
