# Conexión PostgreSQL. Usa el modo SSL que exija el proveedor.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:5432/BASE?sslmode=require

# Cadena aleatoria de 32 o más caracteres para firmar los JWT. No la compartas.
SESSION_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Proxies de confianza delante de la API. Usa 1 detrás de Nginx, Apache o Passenger.
TRUST_PROXY_HOPS=0

# Permite los seeds con cuentas de prueba. No lo definas en producción.
# ALLOW_TEST_SEED=true

# Cliente OAuth y refresh token de la cuenta Google dueña de la carpeta de Drive.
# Solo se usan para guardar y leer adjuntos; el acceso es por correo y contraseña.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_NAME=Imprenta Matisse ERP

HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_TOTAL_BYTES=52428800
MAX_FILES_PER_HOUR=30
